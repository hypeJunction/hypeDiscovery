{
	"name": "hypejunction/hypediscovery",
	"type": "elgg-plugin",
	"description": "Enhanced social presence and discovery of Elgg content in the social eco-system.",
	"homepage": "http://hypejunction.com",
	"keywords": [
		"elgg", "plugin", "open graph", "twitter cards", "facebook", "oembed", "discovery"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"elgg/elgg": "^4.0",
		"composer/installers": "^2.0",
		"mrclay/elgg-url-sniffer": "~3.0"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\Discovery\\": "classes/hypeJunction/Discovery/"
		}
	},
	"extra": {
		"elgg-plugin": {
			"id": "hypediscovery"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
