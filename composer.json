{
	"name": "hypejunction/hypediscovery",
	"type": "elgg-plugin",
	"description": "Enhanced social presence and discovery of Elgg content in the social eco-system.",
	"homepage": "http://hypejunction.com",
	"keywords": [
		"elgg",
		"plugin",
		"open graph",
		"twitter cards",
		"facebook",
		"oembed",
		"discovery"
	],
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"composer/installers": "^1.0 || ^2.0",
		"php": ">=7.2",
		"elgg/elgg": "^3.0",
		"mrclay/elgg-url-sniffer": "~3.0"
	},
	"autoload": {
		"psr-0": {
			"hypeJunction/": "classes/hypeJunction/"
		}
	},
	"extra": {
		"installer-name": "hypeDiscovery"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
